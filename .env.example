# Environment Variables Template
# Copy this file to .env and fill in your actual values
# Never commit the .env file to git!

# MySQL Database Configuration
# Use either the full URL or individual components
MYSQL_URL=mysql+pymysql://username:password@host:port/database

# Alternative: Individual MySQL components
# MYSQL_HOST=your-mysql-host.com
# MYSQL_PORT=17614
# MYSQL_USER=your-username
# MYSQL_PASSWORD=your-password
# MYSQL_DATABASE=defaultdb

# MongoDB Atlas Configuration
# Use either the full URL or individual components
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/?appName=AppName

# Alternative: Individual MongoDB components
# MONGODB_USERNAME=your-mongodb-username
# MONGODB_PASSWORD=your-mongodb-password
# MONGODB_CLUSTER=cluster0.example.mongodb.net
# MONGODB_APP_NAME=Cluster0
MONGODB_DATABASE=hospital_db

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Model Configuration (optional - defaults provided)
MODEL_PATH=models/kidney_disease_rf_model.joblib
FEATURE_NAMES_PATH=models/feature_names.joblib
METADATA_PATH=models/model_metadata.joblib

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=*

# Security (for future use)
SECRET_KEY=your-secret-key-here
JWT_SECRET=your-jwt-secret-here