# ============================================
# Environment Configuration Template
# ============================================
# Copy this file to .env and fill in your actual credentials
# DO NOT commit .env to version control!

# ============================================
# MySQL Database Configuration (Required for SQL API)
# ============================================
# Format: mysql+pymysql://username:password@host:port/database_name
# Examples:
#   Local:  mysql+pymysql://root:mypassword@localhost:3306/kidney_disease_db
#   Aiven:  mysql+pymysql://user:pass@mysql-server.aivencloud.com:12345/kidney_disease_db
#   Remote: mysql+pymysql://admin:secret@192.168.1.100:3306/kidney_disease_db

DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/kidney_disease_db

# ============================================
# MongoDB Configuration (Optional - for MongoDB API)
# ============================================
# Format: mongodb+srv://username:password@cluster.mongodb.net/database_name
# Note: Currently hardcoded in mongo_api/main.py - should be moved here

MONGO_URI=mongodb+srv://hospital_db_user:hospital123@cluster0.8ef3cwc.mongodb.net/hospital_db

# ============================================
# API Configuration
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True

# ============================================
# Model Configuration
# ============================================
MODEL_PATH=../models/kidney_disease_rf_model.joblib
FEATURE_NAMES_PATH=../models/feature_names.joblib
MODEL_METADATA_PATH=../models/model_metadata.joblib

# ============================================
# Application Settings
# ============================================
APP_NAME="Kidney Disease Prediction API"
APP_VERSION="1.0.0"
DEBUG_MODE=True
LOG_LEVEL=INFO
